# General Application Config
ENVIRONMENT=development
SECRET_KEY=super-secret-key-ai-interviewer-pro-2026
NEXTAUTH_SECRET=super-secret-nextauth-key-2026
NEXTAUTH_URL=http://localhost:3000

# API URLs
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=ai_interviewer_db

# OpenAI LLM Engine
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
LLM_FALLBACK_MODE=true

# Cloudinary File Storage (Optional for production cloud upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OAuth (Google Provider)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
