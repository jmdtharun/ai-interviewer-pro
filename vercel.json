{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://ai-interviewer-pro-4pzz.onrender.com/auth/:path*"
    },
    {
      "source": "/interview/:path*",
      "destination": "https://ai-interviewer-pro-4pzz.onrender.com/interview/:path*"
    },
    {
      "source": "/analytics/:path*",
      "destination": "https://ai-interviewer-pro-4pzz.onrender.com/analytics/:path*"
    }
  ]
}
